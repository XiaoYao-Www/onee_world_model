[{"id":"clm-0001","title":"先進製程設備管制使中國取得 EUV 受限","statement":"自 2019 年起 EUV 微影設備對中國實際上處於禁運狀態，加上 2022–2024 年美國與盟國的設備管制，使中國無法在先進邏輯製程（7 奈米以下）進行經濟規模量產。","epistemic_status":"source_claim","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0002","src-0005","src-0006"],"related_entities":["cty-0002","org-0005","org-0007","tec-0001","tec-0004"],"demo":false},{"id":"clm-0002","title":"中芯以 DUV 多重曝光達成 7 奈米級量產","statement":"中芯國際以浸潤式 DUV 多重曝光（N+2）為華為生產麒麟 9000s，達到約 7 奈米級別，證明設備管制不能完全阻止中國量產 7 奈米級邏輯晶片。","epistemic_status":"source_claim","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0009"],"related_entities":["org-0007","org-0008","cty-0002","tec-0004","evt-0005"],"demo":false},{"id":"clm-0004","title":"出口管制加速中國半導體自主化","statement":"美國自 2018 年以來的出口管制，加速了中國政府與企業對半導體自主研發、國內替代與人才培育的投入，其效果部分抵消了管制的技術封鎖目的。","epistemic_status":"hypothesis","confidence":0.35,"supporting":[],"contradicting":[],"sources":["src-0002","src-0008","src-0009"],"related_entities":["cty-0002","org-0007","org-0008","knw-0004"],"demo":false},{"id":"clm-0003","title":"晶片法案補貼不足以讓美國建立成本競爭力","statement":"美國《晶片與科學法案》的 527 億美元補貼與 25% 投資稅額抵減，足以吸引建廠，但不足以使美國在先進製程上達到與台灣、韓國相當的成本競爭力。","epistemic_status":"inference","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0001","src-0010"],"related_entities":["cty-0001","org-0001","org-0004","evt-0001","evt-0008"],"demo":false},{"id":"clm-0005","title":"HBM 成為 AI 晶片供應鏈的新瓶頸","statement":"自 2024 年起，高頻寬記憶體（HBM）的產能與出口管制，成為 AI 加速器供應鏈中與先進製程、先進封裝並列的第二道實質瓶頸。","epistemic_status":"source_claim","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0004","src-0007"],"related_entities":["tec-0003","org-0010","org-0009","org-0002","evt-0010"],"demo":false},{"id":"clm-0006","title":"台積電產能分散降低地緣風險但增加成本","statement":"台積電在美國、日本、德國的產能分散，可降低台灣單點風險並回應客户與政府要求，但會提高製造成本、稀釋毛利並增加管理複雜度。","epistemic_status":"inference","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0007","src-0012","src-0001"],"related_entities":["org-0001","evt-0008","evt-0009","evt-0012","ana-0001"],"demo":false},{"id":"clm-0007","title":"輝達特供晶片策略無法長期維持","statement":"在美國以效能參數（TPP、性能密度）設定門檻的管制下，輝達為中國市場設計的降規特供晶片，無法長期維持合法且具商業價值的地位。","epistemic_status":"inference","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0002","src-0003","src-0004"],"related_entities":["org-0002","evt-0007","cty-0002"],"demo":false},{"id":"clm-0008","title":"荷蘭與日本加入使設備管制更有效","statement":"荷蘭與日本於 2023 年加入半導體設備管制，顯著收窄了中國透過第三國取得先進設備的路徑，使管制比美國單邊措施更有效。","epistemic_status":"source_claim","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0005","src-0006","src-0002"],"related_entities":["cty-0004","cty-0005","evt-0003","org-0005"],"demo":false},{"id":"clm-0009","title":"台灣海峽風險是半導體供應鏈最大尾端風險","statement":"全球先進邏輯晶片產能高度集中於台灣，使台灣海峽的軍事與政治風險成為半導體供應鏈中影響最大、機率難以估計的尾端風險。","epistemic_status":"inference","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0007","src-0010"],"related_entities":["cty-0003","cty-0002","org-0001","clm-0101"],"demo":false},{"id":"clm-0010","title":"AI 擴散規則撤銷顯示單邊全球管制執行困難","statement":"2025 年 1 月發布、5 月撤銷的美國 AI 擴散規則，顯示以單邊方式對全球算力進行分級管制的執行困難，也使美國管制政策的可信度受損。","epistemic_status":"verified_fact","confidence":0.9,"supporting":[],"contradicting":[],"sources":["src-0011"],"related_entities":["cty-0001","org-0011","evt-0011","cty-0002"],"demo":false},{"id":"clm-0011","title":"先進封裝 CoWoS 成為 AI 晶片供給瓶頸","statement":"2023–2025 年間，AI 加速器的供給限制主要來自台積電 CoWoS 先進封裝產能，而非晶圓製造產能本身。","epistemic_status":"source_claim","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0007"],"related_entities":["org-0001","org-0002","tec-0002","tec-0003"],"demo":false},{"id":"clm-0012","title":"摩爾定律放緩提升台積電議價能力","statement":"隨著摩爾定律放緩、先進製程開發與建廠成本上升、可供應商減少，台積電在先進製程的稀缺性與議價能力持續提升。","epistemic_status":"inference","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0007","src-0010"],"related_entities":["org-0001","org-0004","org-0009","knw-0002"],"demo":false},{"id":"clm-0101","title":"台灣海峽的法律地位與管轄爭議","statement":"台灣海峽大部分水域並非任一方的無爭議內水；中華民國（臺灣）主張其領海與毗連區，中華人民共和國主張台灣為其領土並對海峽享有管轄，美國等國則主張國際法上的航行自由。此地理主張應以「重疊主張」記錄，並標明精度為 region。","epistemic_status":"disputed","confidence":0.9,"supporting":[],"contradicting":[],"sources":[],"related_entities":["cty-0003","cty-0002","clm-0009"],"demo":false},{"id":"clm-0102","title":"中國實際控制範圍與對台灣的主權主張","statement":"中華人民共和國實際管轄範圍為中國大陸及其主張之島礁，不包含台灣；但其官方主權主張將台灣列為領土一部分。本模型以 controlled_area 與 territory_claim 兩種角色分開存儲，不將主張當成控制事實。","epistemic_status":"disputed","confidence":0.9,"supporting":[],"contradicting":[],"sources":[],"related_entities":["cty-0002","cty-0003"],"demo":false},{"id":"clm-0103","title":"台積電亞利桑那廠位置精度","statement":"台積電美國廠區（Fab 21）位於亞利桑那州鳳凰城北側，本模型以 precision 為 city 級記錄其近似位置（33.66, -112.12），不輸出精確廠址座標。","epistemic_status":"verified_fact","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0007"],"related_entities":["org-0001","plc-0003","evt-0008"],"demo":false},{"id":"clm-0104","title":"稀土主要產地位置精度","statement":"中國稀土開採與提煉集中於內蒙古包頭白雲鄂博、江西赣州等地；本模型以 precision 為 region 級記錄主要產區，不將礦區座標寫成單一精確點。","epistemic_status":"verified_fact","confidence":0.65,"supporting":[],"contradicting":[],"sources":[],"related_entities":["res-0001","cty-0002"],"demo":false},{"id":"clm-0105","title":"ASML 總部位置與 EUV 單點集中","statement":"ASML 總部與主要 EUV 組裝基地位於荷蘭北布拉邦省費爾德霍芬（約 51.40, 5.40），以 precision 為 city 級記錄。該地因此成為半導體供應鏈中地理集中度最高的節點之一。","epistemic_status":"verified_fact","confidence":0.9,"supporting":[],"contradicting":[],"sources":["src-0005"],"related_entities":["org-0005","plc-0008","cty-0004","tec-0001"],"demo":false},{"id":"clm-0106","title":"熊本 JASM 廠位置精度","statement":"JASM 熊本廠位於日本熊本縣菊陽町（約 32.86, 130.83），本庫以 precision 為 city 級記錄，不輸出精確廠址座標。","epistemic_status":"verified_fact","confidence":0.65,"supporting":[],"contradicting":[],"sources":["src-0012"],"related_entities":["org-0001","plc-0004","evt-0009","cty-0005"],"demo":false},{"id":"demo-clm-0001","title":"示範主張 01","statement":"示範主張：這個句子只示範主張、證據與矛盾並列的呈現方式，不代表任何真實判斷。","epistemic_status":"d