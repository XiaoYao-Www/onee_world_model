{
  "name": "onee-world-model-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "世界模型公開靜態網站：3D 知識宇宙、2.5D 地圖、時間軸、搜尋與來源中心",
  "scripts": {
    "dev": "vite",
