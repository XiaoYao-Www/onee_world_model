{
  "name": "onee-world-model-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "世界模型公開靜態網站：3D 知識宇宙、2.5D 地圖、時間軸、搜尋與來源中心",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "node scripts/clean.mjs && tsc -p app --noEmit && vite build --config app/vite.config.ts",
    "preview": "vite preview --config app/vite.config.ts --port 4173 --strictPort",
    "typecheck": "tsc -p app --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.179.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
